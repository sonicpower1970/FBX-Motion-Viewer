{
  "name": "fbx-motion-viewer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/build-web.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "package:offline": "npm run build && node scripts/package-offline.mjs",
    "test:offline": "node --test tests/offline/*.test.mjs",
    "build:ufbx": "sh scripts/build-ufbx.sh",
    "build:pages": "tsc -b && node scripts/build-web.mjs --pages",
    "test:pages": "node --test tests/pages/*.test.mjs"
  },
  "dependencies": {
    "mediabunny": "1.59.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "fflate": "0.8.3"
  },
  "license": "MIT"
}
